// Shomee — Prisma schema
// Source of truth for persistence. View-model types in lib/types.ts mirror
// the fields here and stay backward-compatible with the existing feed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  AGENT
  ADMIN
}

enum AgencyPlan {
  BASIC
  PRO
  PREMIUM
}

enum MandatType {
  EXCLUSIF
  SIMPLE
  COEXCLUSIF
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum DpeRating {
  A
  B
  C
  D
  E
  F
  G
}

enum PropertyBadge {
  AVANT_PREMIERE
  EXCLUSIVITE
}

enum TagSource {
  AI_VIDEO
  AI_DOC
  AGENT_MANUAL
}

enum VideoAnalysisStatus {
  PENDING
  DONE
  FAILED
}

enum DocumentType {
  PLAN
  PV_AG
  DIAGNOSTIC
  AUTRE
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  // Optionnel : les comptes invités (Continuer sans compte) n'ont pas d'email.
  email        String?       @unique
  name         String?
  avatar       String?
  role         UserRole      @default(BUYER)
  // true tant que le compte n'a pas ete rattache a Apple/Google.
  isGuest      Boolean       @default(false)
  // 'sub' stable des fournisseurs d'identite (verifie cote serveur).
  appleSub     String?       @unique
  googleSub    String?       @unique
  createdAt    DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())

  buyerProfile BuyerProfile?
  devices      UserDevice[]
  conversations Conversation[]
  visits        Visit[]
}

// ─── Messagerie & visites ───────────────────────────────────────────────────
// La conversation est UNIQUE par (acquéreur, bien) : côté mobile, le fil est
// adressé par propertyId — le serveur résout ou crée. L'agent du fil est celui
// qui a créé le bien (source de vérité : Property.createdByAgentId).

enum MessageSender {
  BUYER
  AGENT
}

enum MessageKind {
  TEXT
  VISIT_REQUEST // demande de visite — payload = brief qualifié + score
  AVAILABILITIES // disponibilités de l'acquéreur — payload = créneaux cochés
  VISIT_CONFIRMED // visite calée par l'agent — payload = {visitId, scheduledAt…}
  SYSTEM // événements neutres (annulation…) — rendu discret des deux côtés
}

enum VisitStatus {
  CONFIRMED
  CANCELLED
}

model Conversation {
  id              String    @id @default(cuid())
  propertyId      String
  buyerUserId     String
  agentId         String
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())
  // Curseurs de lecture — un par côté. « Non lu » = messages de l'AUTRE côté
  // postérieurs à mon curseur.
  buyerLastReadAt DateTime?
  agentLastReadAt DateTime?

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    User      @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages Message[]
  visits   Visit[]

  @@unique([buyerUserId, propertyId])
  @@index([agentId, lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  kind           MessageKind   @default(TEXT)
  text           String
  // Charge structurée selon kind (brief de la demande, créneaux, visite…).
  payload        Json?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Visit {
  id             String      @id @default(cuid())
  conversationId String
  propertyId     String
  buyerUserId    String
  agentId        String
  scheduledAt    DateTime
  durationMin    Int         @default(30)
  status         VisitStatus @default(CONFIRMED)
  // Capability token du fichier .ics : les apps d'agenda ne savent pas envoyer
  // d'en-têtes — le lien EST l'authentification. Non devinable, révocable en
  // annulant la visite.
  icsToken       String      @unique @default(cuid())
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer        User         @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, scheduledAt])
  @@index([buyerUserId, scheduledAt])
}

// Pont deviceId anonyme (tracker.ts) -> User. Les grosses tables
// comportementales restent clees par deviceId ; ce mapping permet de
// resoudre le user et de migrer/rattacher a la connexion (invite ou compte).
model UserDevice {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BuyerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  parsedCriteria    Json     @default("[]")
  rawTags           String[] @default([])
  searchPreferences Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agency {
  id            String     @id @default(cuid())
  name          String
  logo          String?
  plan          AgencyPlan @default(BASIC)
  maxProperties Int        @default(10)
  createdAt     DateTime   @default(now())

  agents        Agent[]
  properties    Property[]
}

model Agent {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  avatar     String?
  agencyId   String
  createdAt  DateTime   @default(now())

  // ── Connexion (back-office web) ──
  // Nullable : un compte est créé par l'admin SANS mot de passe, puis activé
  // par l'agent via son lien d'activation (setupToken). Les clés d'API
  // (AgentApiKey) restent le schéma d'auth des intégrations machine
  // (connecteurs Claude/ChatGPT) — les deux portes mènent à la même identité.
  passwordHash      String?
  setupToken        String?   @unique
  setupTokenExpires DateTime?

  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  properties Property[] @relation("PropertyCreatedBy")
  apiKeys    AgentApiKey[]
  conversations Conversation[]
  visits        Visit[]

  @@index([agencyId])
}

model AgentApiKey {
  id        String    @id @default(cuid())
  agentId   String
  key       String    @unique
  label     String
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ─── Property ───────────────────────────────────────────────────────────────

model Property {
  id                    String          @id @default(cuid())

  // Feed display (denormalised for fast reads)
  arrondissement        String
  subtitle              String
  agentName             String
  agentAvatar           String?

  // Core
  title                 String
  price                 Int
  pricePerSqm           Int?
  surface               Float
  rooms                 Int
  bedrooms              Int?
  location              String
  district              String
  // Adresse exacte — back-office uniquement, jamais affichée en front. Fondation
  // du futur chemin IRIS/DVF réel (géocodage → zone IRIS). Nullable : legacy + vrais biens.
  address               String?
  description           String          @db.Text
  tags                  String[]        @default([])
  features              String[]        @default([])
  dpe                   DpeRating
  ges                   DpeRating?

  // Physical
  floor                 Int?
  totalFloors           Int?
  orientation           String?
  exteriorType          String?
  heatingType           String?
  hotWaterType          String?
  yearBuilt             Int?
  lotCount              Int?
  proceduresEnCours     Boolean?
  monthlyCharges        Int?
  propertyTax           Int?

  // Composition / IRIS / map / market (JSON for nested structures)
  composition           Json?           // Array<{ label, surface }>
  irisZone              String?
  irisDescription       String?
  irisPolygon           Json?           // [number, number][]
  mapLat                Float?
  mapLng                Float?
  transports            String[]        @default([])
  nearbyPlaces          String[]        @default([])
  neighborhoodVibe      String?
  mapTransports         Json?           // Array<{ name, line, lat, lng }>
  mapPois               Json?           // Array<{ name, lat, lng }>
  marketAvgPricePerSqm  Int?
  marketEvolution10y    String?
  marketHighPrice       Int?
  marketLowPrice        Int?

  // Media
  videoUrl              String?
  matterportUrl         String?
  imageUrlFallback      String
  gallery               String[]        @default([])
  chapters              Json?           // Array<{ label, fraction }>

  // Social
  likeCount             Int             @default(0)
  shareCount            Int             @default(0)
  promising             Boolean         @default(false)
  badges                PropertyBadge[] @default([])

  // ── Structured attributes (matching engine) ──
  // TRI-ÉTAT (D1) : null = NON RENSEIGNÉ (doute), false = affirmé absent.
  // Migration depuis @default(false) : le backfill (scripts/backfill-attributes)
  // remet à NULL ce qui n'est pas affirmé par features/tags/description, puis
  // ré-affirme ce que le texte prouve. Widening non destructif.
  hasElevator           Boolean?
  hasTerrace            Boolean?
  terraceSurfaceM2      Float?
  hasBalcony            Boolean?
  balconySurfaceM2      Float?
  hasGarden             Boolean?
  gardenSurfaceM2       Float?
  hasCellar             Boolean?
  hasParking            Boolean?
  hasConcierge          Boolean?
  isGroundFloor         Boolean?
  bedroomStreetSide     Boolean?
  isQuietStreet         Boolean?
  orientationStructured String[]        @default([]) // 'north'|'south'|'east'|'west'
  // ── Attributs pivot (harmonisation sémantique) ──
  hasVisAVis            Boolean?
  isRenovated           Boolean?
  hasFireplace          Boolean?
  isTraversant          Boolean?
  // IRIS d'appartenance calculé hors-ligne (backfill : mapLat/mapLng →
  // point-in-polygon). Fondation du filtre géo exact du feed réel.
  irisId                String?

  // ── Semantic scores 0..1 ──
  luminosity            Float?
  quietness             Float?
  charm                 Float?
  spaciousness          Float?
  livingQuality         Float?
  outdoorUsability      Float?

  // ── Sprint fields ──
  mandatType            MandatType      @default(SIMPLE)
  avantPremiere         Boolean         @default(false)
  refInterneAgence      String?
  statut                PropertyStatus  @default(DRAFT)
  completionRate        Float           @default(0)
  collaborateurIds      String[]        @default([])

  // ── Démo / enrichissement ──
  // true = champs enrichis peuplés par le backfill démo (données fausses mais
  // plausibles) ; false = vrai bien (chemin IRIS/DVF réel, à venir).
  isDemoData            Boolean         @default(false)

  llmFilledFields        String[]        @default([])

  // ── Source fields (populated by LLM import) ──
  locationSource         String?
  titleSource            String?
  priceSource            String?
  surfaceSource          String?
  roomsSource            String?
  bedroomsSource         String?
  descriptionSource      String?
  floorSource            String?
  yearBuiltSource        String?
  dpeSource              String?
  gesSource              String?
  mandatTypeSource       String?
  refInterneAgenceSource String?
  monthlyChargesSource   String?
  propertyTaxSource      String?
  compositionSource      String?

  // ── Partage public (P0 — page /p/<token>) ──
  // Token non devinable, généré à la première demande de lien : nullable tant
  // que le bien n’a jamais été partagé. `isShareable` est le garde-fou
  // off-market — coupé, le lien rend une page morte.
  shareToken            String?         @unique
  isShareable           Boolean         @default(true)

  // Relations
  agencyId              String
  createdByAgentId      String
  agency                Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdByAgent        Agent           @relation("PropertyCreatedBy", fields: [createdByAgentId], references: [id], onDelete: Restrict)

  propertyTags          PropertyTag[]
  videoAnalysis         VideoAnalysis?
  documents             Document[]
  shareViews            ShareView[]
  conversations         Conversation[]
  visits                Visit[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([agencyId])
  @@index([createdByAgentId])
  @@index([statut])
  @@index([avantPremiere])
  @@index([irisId])
}

model PropertyTag {
  id          String    @id @default(cuid())
  propertyId  String
  label       String
  category    String    // CriterionCategory: outdoor|bedroom|living|building|location|ambiance
  source      TagSource
  validated   Boolean   @default(false)
  confidence  Float     @default(0)
  criterionId String?

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([category])
}

model VideoAnalysis {
  id          String              @id @default(cuid())
  propertyId  String              @unique
  status      VideoAnalysisStatus @default(PENDING)
  chapitres   Json?               // Array<{ label, fraction }>
  extractedAt DateTime?

  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Document {
  id         String       @id @default(cuid())
  propertyId String
  url        String
  type       DocumentType
  nom        String

  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@index([propertyId])
}

// ─── Partage public d’un bien (P0) ─────────────────────────────────────────
// Une ligne par rendu serveur de la page /p/<token>. `isBot` marque les
// crawlers d’aperçu (WhatsApp, Facebook, Slack…) : ils déclenchent un hit à
// chaque lien collé dans une conversation et ne doivent pas gonfler les vues
// réelles. On loggue tout, le flag fait le tri.

model ShareView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ref        String?
  userAgent  String?
  isBot      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// ─── Buyer AI brief — magic-link tokens (multi-use, 24h TTL) ──────────────
// Generated by an external LLM via POST /api/buyer/onboarding-prefill,
// read by GET /api/buyer/onboarding-prefill?token=… when the acquéreur
// opens /onboarding?brief=<uuid>. The token stays usable until expiresAt
// so the link can be reopened from email/messaging history.

model BuyerBriefToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(uuid())
  briefJson Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

// ─── Handoff LLM → app native (S9) ──────────────────────────────────────────
// Successeur natif du BuyerBriefToken (conservé pour l'ancien flux PWA).
// Créé par un LLM via POST /api/handoff/create (bearer d'intégration),
// affiché par la landing /h/<token>, réclamé par l'app native via
// POST /api/handoff/claim (Bearer JWT invité ou compte). Référence :
// claude/ARCHITECTURE_ONBOARDING_HANDOFF.md (projet Cowork).

model Handoff {
  id              String    @id @default(cuid())
  token           String    @unique @default(uuid())
  /// Canonique SANS tiret (affiché « 4F2A-9K2 »), alphabet non ambigu.
  shortCode       String    @unique
  /// first_brief | edit (parcours B, post-H5)
  kind            String    @default("first_brief")
  /// chatgpt | claude | web
  source          String
  /// AIOnboardingBrief + optionnels : parsed[] (passthrough), transcriptSummary.
  brief           Json
  /// kind=edit : delta proposé (patch) — réservé parcours B.
  diff            Json?
  /// kind=edit : utilisateur au nom duquel le LLM agit — réservé parcours B.
  userId          String?
  /// pending | claimed | expired
  status          String    @default("pending")
  claimedByUserId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  claimedAt       DateTime?

  @@index([expiresAt])
}


// ─── Profil acquéreur — données comportementales (P5) ───────────────────────
// Pré-comptes (S8) : tout est rattaché à un deviceId anonyme (uuid généré
// côté app, persisté AsyncStorage). Le rattachement au User viendra avec
// Sign in Apple/Google.

model InteractionEvent {
  id          String   @id @default(cuid())
  deviceId    String
  propertyId  String?
  /// video_start | dwell | skip | skip_fast | detail_open | detail_dwell |
  /// fav | unfav | share | contact | map_open | probe_answer | session_start
  type        String
  /// Durée associée (ms) pour dwell / detail_dwell.
  valueMs     Int?
  /// main | discovery — voie de service du bien au moment de l'événement.
  lane        String?
  /// Score affiché au moment du service (calibré, 0..100).
  servedScore Int?
  /// Empreinte de la révision de critères active (traçabilité).
  criteriaHash String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([propertyId])
  @@index([type])
}

model CriteriaRevision {
  id        String   @id @default(cuid())
  deviceId  String
  /// Snapshot complet des critères déclarés au moment T.
  snapshot  Json
  /// onboarding | edit | interstitial | system
  source    String
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model BuyerAffinity {
  id         String   @id @default(cuid())
  deviceId   String
  /// Attribut pivot (has_terrace, quartier:xxx, floor_high…).
  attribute  String
  /// Poids appris −1..+1.
  weight     Float
  /// Confiance 0..1 (croît avec le volume d'événements, décroît avec le temps).
  confidence Float
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, attribute])
  @@index([deviceId])
}

model CriteriaSuggestion {
  id        String    @id @default(cuid())
  deviceId  String
  /// probe_skip | widen_budget | widen_zone | relax_criterion | confirm_dislike
  type      String
  payload   Json
  evidence  Json?
  /// pending | shown | accepted | rejected | dismissed
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([deviceId, status])
}
