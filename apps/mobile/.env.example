# Backend mobile — copier ce fichier en `.env` (gitignoré) et remplir les valeurs.
# Les variables EXPO_PUBLIC_* sont inlinées par Metro et lues EN DIRECT via
# process.env dans src/lib/api.ts. Restart Metro (expo start -c) après édition.

# Base URL de l'API. Vide => fallback alias de branche (voir src/lib/api.ts).
EXPO_PUBLIC_API_BASE_URL=

# Token applicatif — envoyé en header `x-shomee-app-token`
# (garde serveur requireAppTokenOrTrustedOrigin, env serveur SHOMEE_APP_TOKEN).
EXPO_PUBLIC_SHOMEE_APP_TOKEN=

# Secret Vercel « Protection Bypass for Automation » — envoyé en header
# `x-vercel-protection-bypass` pour traverser la Deployment Protection du preview.
EXPO_PUBLIC_VERCEL_BYPASS_TOKEN=
