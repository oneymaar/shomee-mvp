{
  "expo": {
    "name": "SHOMEE",
    "slug": "shomee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shomee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.shomee.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shomee.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-shomee-terracotta.png",
          "imageWidth": 140,
          "backgroundColor": "#FDF5F2",
          "dark": {
            "image": "./assets/images/logo-shomee-terracotta.png",
            "backgroundColor": "#FDF5F2"
          }
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "SHOMEE accède à vos photos pour définir votre photo de profil."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "shomeeApiBaseUrl": "https://shomee-mvp-git-feat-monorepo-oneymaars-projects.vercel.app",
      "shomeeAppToken": "",
      "vercelBypassToken": "",
      "router": {},
      "eas": {
        "projectId": "a79aae8c-587b-43c4-9131-8d3bad3645f4"
      }
    },
    "owner": "neymaarjr"
  }
}
